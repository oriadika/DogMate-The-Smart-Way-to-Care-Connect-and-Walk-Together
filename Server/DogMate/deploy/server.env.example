# Copy this file to Server/DogMate/server.env and fill in your values.
# Do not commit real secrets to source control.

SPRING_DATASOURCE_URL=jdbc:postgresql://<POSTGRES_HOST>:<PORT>/<DATABASE>?sslmode=require&prepareThreshold=0
SPRING_DATASOURCE_USERNAME=<DB_USERNAME>
SPRING_DATASOURCE_PASSWORD=<DB_PASSWORD>

SPRING_MAIL_USERNAME=<SMTP_USERNAME>
SPRING_MAIL_PASSWORD=<SMTP_PASSWORD>
DOGMATE_MAIL_FROM=<SENDER_EMAIL>

SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_STARTTLS_ENABLE=true
SPRING_MAIL_STARTTLS_REQUIRED=true
SPRING_MAIL_SSL_TRUST=smtp.gmail.com
