# Copy to `.env` in this folder (Server/DogMate/) — never commit `.env`

# --- One-time Supabase → local Docker import ---
# Run: ./scripts/pull-supabase-to-local.sh
# Get password: Supabase Dashboard → Project Settings → Database
SUPABASE_HOST=aws-1-ap-southeast-1.pooler.supabase.com
SUPABASE_PORT=5432
SUPABASE_DB=postgres
SUPABASE_USER=postgres.xdaxkncdjhlqlupaxuzd
SUPABASE_PASSWORD=YuvalGenislav

# After import, disable auto-seed in application.properties:
# dogmate.local.seed.enabled=false

# --- Optional: seed a dev user only when DB is empty (skip after Supabase import) ---
DOGMATE_DEV_SEED_EMAIL=dev@dogmate.local
DOGMATE_DEV_SEED_PASSWORD=Dogmate123!
DOGMATE_DEV_SEED_FIRST_NAME=Dev
DOGMATE_DEV_SEED_LAST_NAME=User

# Production / EC2 (uncomment in application.properties when deploying):
# SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require&prepareThreshold=0
# SPRING_DATASOURCE_USERNAME=postgres.xdaxkncdjhlqlupaxuzd
# SPRING_DATASOURCE_PASSWORD=YOUR_SUPABASE_DB_PASSWORD
