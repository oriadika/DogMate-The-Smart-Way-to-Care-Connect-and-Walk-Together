{
  "expo": {
    "name": "dogmate-client",
    "slug": "dogmate-client",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/LoadingPage.jpg",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/LoadingPage.jpg",
      "resizeMode": "cover",
      "backgroundColor": "#FAEFDD"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.dogmateclient",
      "config": {
        "googleMapsApiKey": ""
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAEFDD"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.dogmateclient",
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#7FB069",
          "defaultChannel": "default"
        }
      ]
    ]
  }
}
